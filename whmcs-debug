define('TOKEN', 'resellnom2025secret'); // same as clear-cache.php
if(($_GET['token']??'') !== TOKEN){ echo 'Unauthorized'; exit; }

$whmcs = 'https://my.resellnom.com';
$pids  = [4, 6, 9];
$currency = 2; // BDT

function curlGet($url) {
    $ch = curl_init($url);
    curl_setopt_array($ch,[
        CURLOPT_RETURNTRANSFER => true,
        CURLOPT_TIMEOUT        => 8,
        CURLOPT_SSL_VERIFYPEER => false,
        CURLOPT_FOLLOWLOCATION => true,
        CURLOPT_USERAGENT      => 'Mozilla/5.0',
    ]);
    $body = curl_exec($ch);
    $code = curl_getinfo($ch, CURLINFO_HTTP_CODE);
    $err  = curl_error($ch);
    curl_close($ch);
    return ['body'=>$body,'code'=>$code,'error'=>$err];
}

$results = [];
foreach($pids as $pid) {
    $results[$pid] = [
        'price_monthly' => curlGet("$whmcs/feeds/productsinfo.php?pid=$pid&get=price&billingcycle=monthly&currency=$currency"),
        'price_annual'  => curlGet("$whmcs/feeds/productsinfo.php?pid=$pid&get=price&billingcycle=annually&currency=$currency"),
        'name'          => curlGet("$whmcs/feeds/productsinfo.php?pid=$pid&get=name"),
        'products_json' => curlGet("$whmcs/feeds/products.php?pid=$pid&currency=$currency"),
    ];
}
